{
  "name": "cairn",
  "version": "0.0.0",
  "private": true,
  "description": "Ask about the GitHub repo you're reading, in a side panel.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "index": "node scripts/build-index.ts",
    "ask": "node scripts/ask.ts",
    "evals": "node evals/run.ts",
    "evals:propose": "node evals/propose.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.portable.json"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "minisearch": "^7.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
